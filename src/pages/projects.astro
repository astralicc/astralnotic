---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getShowcaseItems, formatRichText } from '../lib/supabase';

const sortedProjects = await getProjects();
const showcaseItems = await getShowcaseItems();
---

<BaseLayout
  title="Projects — Alex Chen"
  description="Selected software engineering projects and open-source tools."
>
  <div class="space-y-4 max-w-4xl mx-auto">
    <!-- Header Section -->
    <div class="space-y-2 border-b border-[#d0d0d0] dark:border-[#404040] pb-6 mb-2">
      <!-- Page Title: Projects (Capitalized) -->
      <h1 class="text-xl font-bold tracking-tight text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
        Projects
      </h1>
      <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
        A selected collection of production web applications, open-source software, and design systems.
      </p>
    </div>

    <!-- Quiet Editorial Stack (Side-by-Side 2-Column Split for media, Flat rows for text) -->
    <div id="projects-list">
      {
        sortedProjects.map((project) => {
          const hasImage = Boolean(project.image_url);
          const hasLiveUrl = Boolean(project.live_url);
          const hasGithubUrl = Boolean(project.github_url);

          if (hasImage) {
            return (
              <article class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                <!-- Left Column (5 Cols — Framed Media Window) -->
                <div class="md:col-span-5">
                  <a
                    href={`/projects/${project.slug}`}
                    class="block overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] group bg-neutral-900/90"
                  >
                    <img
                      src={project.image_url!}
                      alt={project.title}
                      class="w-full h-auto max-h-64 object-contain group-hover:scale-105 transition-transform duration-300 mx-auto"
                    />
                  </a>
                </div>

                <!-- Right Column (7 Cols — Content & Typography) -->
                <div class="md:col-span-7 space-y-3">
                  <!-- Header Row: Title Left, Year & Links Right -->
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                    <h2 class="text-base font-bold font-pixel">
                      <a
                        href={`/projects/${project.slug}`}
                        class="link-slate"
                      >
                        {project.title}
                      </a>
                    </h2>

                    <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                      <span>{project.date}</span>
                      <span>/</span>
                      {hasLiveUrl && (
                        <>
                          <a
                            href={project.live_url!}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-slate"
                          >
                            Live Demo ↗
                          </a>
                          <span>/</span>
                        </>
                      )}
                      {hasGithubUrl && (
                        <>
                          <a
                            href={project.github_url!}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-slate"
                          >
                            GitHub ↗
                          </a>
                          <span>/</span>
                        </>
                      )}
                      <a
                        href={`/projects/${project.slug}`}
                        class="link-slate"
                      >
                        View Case Study →
                      </a>
                    </div>
                  </div>

                  <!-- 2-Sentence Description -->
                  <p set:html={project.description} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />

                  <!-- Tech Stack Tags -->
                  <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">
                    {project.tags.join(' · ')}
                  </div>
                </div>
              </article>
            );
          } else {
            return (
              <article class="space-y-3 py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                <!-- Flat text row layout without image container -->
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                  <h2 class="text-base font-bold font-pixel">
                    <a
                      href={`/projects/${project.slug}`}
                      class="link-slate"
                    >
                      {project.title}
                    </a>
                  </h2>

                  <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                    <span>{project.date}</span>
                    <span>/</span>
                    {hasLiveUrl && (
                      <>
                        <a
                          href={project.live_url!}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-slate"
                        >
                          Live Demo ↗
                        </a>
                        <span>/</span>
                      </>
                    )}
                    {hasGithubUrl && (
                      <>
                        <a
                          href={project.github_url!}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-slate"
                        >
                          GitHub ↗
                        </a>
                        <span>/</span>
                      </>
                    )}
                    <a
                      href={`/projects/${project.slug}`}
                      class="link-slate"
                    >
                      View Case Study →
                    </a>
                  </div>
                </div>

                <p set:html={project.description} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />

                <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">
                  {project.tags.join(' · ')}
                </div>
              </article>
            );
          }
        })
      }
    </div>

    <!-- Hairline Divider & Showcase Section -->
    <div class="border-t border-[#d0d0d0] dark:border-[#404040] pt-12 mt-12 space-y-6">
      <div class="space-y-1">
        <h2 class="text-xs font-pixel font-bold tracking-wider text-neutral-500 dark:text-neutral-400 uppercase">
          Showcase
        </h2>
        <p class="text-xs font-sans text-neutral-500 dark:text-neutral-400">
          Experiments, micro-tools, and visual concepts.
        </p>
      </div>

      <div id="showcase-list" class="space-y-6">
        {
          showcaseItems.map((item) => {
            const hasImage = Boolean(item.image_url);
            if (hasImage) {
              return (
                <article class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center py-6 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="md:col-span-5">
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] group bg-neutral-900/90"
                      >
                        <img
                          src={item.image_url!}
                          alt={item.title}
                          class="w-full h-auto max-h-56 object-contain group-hover:scale-105 transition-transform duration-300 mx-auto"
                        />
                      </a>
                    ) : (
                      <div class="overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] bg-neutral-900/90">
                        <img
                          src={item.image_url!}
                          alt={item.title}
                          class="w-full h-auto max-h-56 object-contain mx-auto"
                        />
                      </div>
                    )}
                  </div>

                  <div class="md:col-span-7 space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                      <h3 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-[#e8e8e8]">
                        {item.url ? (
                          <a
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-slate"
                          >
                            {item.title} ↗
                          </a>
                        ) : (
                          <span>{item.title}</span>
                        )}
                      </h3>

                      {item.tags && item.tags.length > 0 && (
                        <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 shrink-0">
                          {item.tags.join(' · ')}
                        </div>
                      )}
                    </div>

                    <p set:html={formatRichText(item.description)} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />
                  </div>
                </article>
              );
            } else {
              return (
                <article class="py-4 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 pb-4 space-y-2">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                    <h3 class="text-sm font-bold font-pixel text-[#1a1a1a] dark:text-[#e8e8e8]">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-slate"
                        >
                          {item.title} ↗
                        </a>
                      ) : (
                        <span>{item.title}</span>
                      )}
                    </h3>

                    {item.tags && item.tags.length > 0 && (
                      <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 shrink-0">
                        {item.tags.join(' · ')}
                      </div>
                    )}
                  </div>

                  <p set:html={formatRichText(item.description)} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />
                </article>
              );
            }
          })
        }
      </div>
    </div>
  </div>

  <!-- Client-side hydration script for instant live Supabase data updates -->
  <script>
    import { getProjects, getShowcaseItems, formatRichText } from '../lib/supabase';

    async function refreshProjectsPage() {
      try {
        const [projects, showcases] = await Promise.all([
          getProjects(),
          getShowcaseItems(),
        ]);

        const container = document.getElementById('projects-list');
        if (container && projects && projects.length > 0) {
          container.innerHTML = projects
            .map((project) => {
              const hasImage = Boolean(project.image_url);
              const hasLiveUrl = Boolean(project.live_url);
              const hasGithubUrl = Boolean(project.github_url);
              const tagStr = project.tags ? project.tags.join(' · ') : '';

              const liveLinkHtml = hasLiveUrl
                ? `<a href="${project.live_url}" target="_blank" rel="noopener noreferrer" class="link-slate">Live Demo ↗</a><span>/</span>`
                : '';
              const githubLinkHtml = hasGithubUrl
                ? `<a href="${project.github_url}" target="_blank" rel="noopener noreferrer" class="link-slate">GitHub ↗</a><span>/</span>`
                : '';

              if (hasImage) {
                return `
                <article class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="md:col-span-5">
                    <a href="/projects/${project.slug}" class="block overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] group bg-neutral-900/90">
                      <img src="${project.image_url}" alt="${project.title}" class="w-full h-auto max-h-64 object-contain group-hover:scale-105 transition-transform duration-300 mx-auto" />
                    </a>
                  </div>
                  <div class="md:col-span-7 space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                      <h2 class="text-base font-bold font-pixel">
                        <a href="/projects/${project.slug}" class="link-slate">${project.title}</a>
                      </h2>
                      <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                        <span>${project.date}</span>
                        <span>/</span>
                        ${liveLinkHtml}
                        ${githubLinkHtml}
                        <a href="/projects/${project.slug}" class="link-slate">View Case Study →</a>
                      </div>
                    </div>
                    <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${project.description}</p>
                    <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">${tagStr}</div>
                  </div>
                </article>`;
              } else {
                return `
                <article class="space-y-3 py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                    <h2 class="text-base font-bold font-pixel">
                      <a href="/projects/${project.slug}" class="link-slate">${project.title}</a>
                    </h2>
                    <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                      <span>${project.date}</span>
                      <span>/</span>
                      ${liveLinkHtml}
                      ${githubLinkHtml}
                      <a href="/projects/${project.slug}" class="link-slate">View Case Study →</a>
                    </div>
                  </div>
                  <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${project.description}</p>
                  <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">${tagStr}</div>
                </article>`;
              }
            })
            .join('');
        }

        const showcaseContainer = document.getElementById('showcase-list');
        if (showcaseContainer && showcases && showcases.length > 0) {
          showcaseContainer.innerHTML = showcases
            .map((item) => {
              const hasImage = Boolean(item.image_url);
              const tagStr = item.tags && item.tags.length > 0
                ? `<div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 shrink-0">${item.tags.join(' · ')}</div>`
                : '';
              const titleHtml = item.url
                ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-slate">${item.title} ↗</a>`
                : `<span>${item.title}</span>`;

              if (hasImage) {
                const imgWrap = item.url
                  ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] group bg-neutral-900/90"><img src="${item.image_url}" alt="${item.title}" class="w-full h-auto max-h-56 object-contain group-hover:scale-105 transition-transform duration-300 mx-auto" /></a>`
                  : `<div class="overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] bg-neutral-900/90"><img src="${item.image_url}" alt="${item.title}" class="w-full h-auto max-h-56 object-contain mx-auto" /></div>`;

                return `
                <article class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center py-6 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="md:col-span-5">${imgWrap}</div>
                  <div class="md:col-span-7 space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                      <h3 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-[#e8e8e8]">${titleHtml}</h3>
                      ${tagStr}
                    </div>
                    <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${formatRichText(item.description)}</p>
                  </div>
                </article>`;
              } else {
                return `
                <article class="py-4 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 pb-4 space-y-2">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                    <h3 class="text-sm font-bold font-pixel text-[#1a1a1a] dark:text-[#e8e8e8]">${titleHtml}</h3>
                    ${tagStr}
                  </div>
                  <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${formatRichText(item.description)}</p>
                </article>`;
              }
            })
            .join('');
        }
      } catch {
        // Keep pre-rendered HTML
      }
    }

    refreshProjectsPage();
    document.addEventListener('astro:after-swap', refreshProjectsPage);
  </script>
</BaseLayout>
