---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getShowcaseItems, formatRichText } from '../lib/supabase';

const sortedProjects = await getProjects();
const showcaseItems = await getShowcaseItems();
---

<BaseLayout
  title="Projects — Alex Chen"
  description="Selected software engineering projects and open-source tools."
>
  <div class="space-y-4 max-w-4xl mx-auto">
    <!-- Header Section -->
    <div class="space-y-2 pb-1">
      <!-- Page Title: Projects (Capitalized) -->
      <h1 class="text-xl font-bold tracking-tight text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
        Projects
      </h1>
      <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
        A selected collection of production web applications, open-source software, and design systems.
      </p>
    </div>

    <!-- Terminal / ASCII Sub-Navigation Filter Tabs -->
    <div class="flex flex-wrap items-center gap-6 py-3 border-b border-neutral-300/60 dark:border-neutral-800/60 font-pixel text-xs uppercase tracking-wider">
      <button
        data-filter="all"
        class="project-tab-btn text-[#1a1a1a] dark:text-neutral-100 font-bold transition-colors duration-150 cursor-pointer flex items-center gap-1.5 group"
      >
        <span class="tab-prompt text-emerald-500 font-bold">&gt;</span>
        <span>ALL</span>
      </button>
      <button
        data-filter="main"
        class="project-tab-btn text-neutral-500 hover:text-[#1a1a1a] dark:hover:text-neutral-200 font-normal transition-colors duration-150 cursor-pointer flex items-center gap-1.5 group"
      >
        <span class="tab-prompt text-emerald-500 font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-150">&gt;</span>
        <span>MAIN PROJECTS</span>
      </button>
      <button
        data-filter="side"
        class="project-tab-btn text-neutral-500 hover:text-[#1a1a1a] dark:hover:text-neutral-200 font-normal transition-colors duration-150 cursor-pointer flex items-center gap-1.5 group"
      >
        <span class="tab-prompt text-emerald-500 font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-150">&gt;</span>
        <span>SIDE PROJECTS & LABS</span>
      </button>
    </div>

    <!-- Main Projects Section -->
    <section id="main-projects-section" class="space-y-6 transition-all duration-200 mt-6">
      <div class="space-y-1.5 border-b border-neutral-300 dark:border-neutral-800 pb-4">
        <h2 class="text-xs font-pixel font-bold tracking-wider text-neutral-500 dark:text-neutral-400 uppercase">
          Main Projects
        </h2>
        <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Selected production web applications, open-source software, and design systems.
        </p>
      </div>

      <div id="projects-list">
        {
          sortedProjects.map((project) => {
            const hasImage = Boolean(project.image_url);
            const hasLiveUrl = Boolean(project.live_url);
            const hasGithubUrl = Boolean(project.github_url);

            if (hasImage) {
              return (
                <article class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="md:col-span-5">
                    <a
                      href={`/projects/${project.slug}`}
                      class="block overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] group bg-neutral-900/90"
                    >
                      <img
                        src={project.image_url!}
                        alt={project.title}
                        class="w-full h-auto max-h-64 object-contain group-hover:scale-105 transition-transform duration-300 mx-auto"
                      />
                    </a>
                  </div>

                  <div class="md:col-span-7 space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                      <h2 class="text-base font-bold font-pixel">
                        <a
                          href={`/projects/${project.slug}`}
                          class="link-slate"
                        >
                          {project.title}
                        </a>
                      </h2>

                      <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                        <span>{project.date}</span>
                        <span>/</span>
                        {hasLiveUrl && (
                          <>
                            <a
                              href={project.live_url!}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="link-slate"
                            >
                              Live Demo ↗
                            </a>
                            <span>/</span>
                          </>
                        )}
                        {hasGithubUrl && (
                          <>
                            <a
                              href={project.github_url!}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="link-slate"
                            >
                              GitHub ↗
                            </a>
                            <span>/</span>
                          </>
                        )}
                        <a
                          href={`/projects/${project.slug}`}
                          class="link-slate"
                        >
                          View Case Study →
                        </a>
                      </div>
                    </div>

                    <p set:html={project.description} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />

                    <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">
                      {project.tags.join(' · ')}
                    </div>
                  </div>
                </article>
              );
            } else {
              return (
                <article class="space-y-3 py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                    <h2 class="text-base font-bold font-pixel">
                      <a
                        href={`/projects/${project.slug}`}
                        class="link-slate"
                      >
                        {project.title}
                      </a>
                    </h2>

                    <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                      <span>{project.date}</span>
                      <span>/</span>
                      {hasLiveUrl && (
                        <>
                          <a
                            href={project.live_url!}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-slate"
                          >
                            Live Demo ↗
                          </a>
                          <span>/</span>
                        </>
                      )}
                      {hasGithubUrl && (
                        <>
                          <a
                            href={project.github_url!}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-slate"
                          >
                            GitHub ↗
                          </a>
                          <span>/</span>
                        </>
                      )}
                      <a
                        href={`/projects/${project.slug}`}
                        class="link-slate"
                      >
                        View Case Study →
                      </a>
                    </div>
                  </div>

                  <p set:html={project.description} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />

                  <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">
                    {project.tags.join(' · ')}
                  </div>
                </article>
              );
            }
          })
        }
      </div>
    </section>

    <!-- Hairline Divider & Showcase Section (Side Projects & Experiments) -->
    <section id="showcase-projects-section" class="space-y-8 transition-all duration-200 border-t border-neutral-200 dark:border-neutral-800 pt-12 sm:pt-16 mt-12 sm:mt-16">
      <div class="space-y-1.5 border-b border-neutral-300 dark:border-neutral-800 pb-4">
        <h2 class="text-xs font-pixel font-bold tracking-wider text-neutral-500 dark:text-neutral-400 uppercase">
          Side Projects & Experiments
        </h2>
        <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Experimental creations, micro-tools, and visual concepts built in my spare time!
        </p>
      </div>

      <div id="showcase-list" class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10 mt-6 sm:mt-8">
        {
          showcaseItems.map((item) => {
            const hasImage = Boolean(item.image_url);
            return (
              <article class="flex flex-col space-y-4 group">
                {hasImage && (
                  <div class="w-full aspect-[16/10] overflow-hidden rounded-xl border border-neutral-300 dark:border-neutral-800 bg-neutral-900/90 relative">
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block w-full h-full"
                      >
                        <img
                          src={item.image_url!}
                          alt={item.title}
                          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300 ease-out"
                        />
                      </a>
                    ) : (
                      <img
                        src={item.image_url!}
                        alt={item.title}
                        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300 ease-out"
                      />
                    )}
                  </div>
                )}

                <div class="space-y-2">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5">
                    <h3 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-[#e8e8e8]">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link-slate"
                        >
                          {item.title} ↗
                        </a>
                      ) : (
                        <span>{item.title}</span>
                      )}
                    </h3>

                    {item.tags && item.tags.length > 0 && (
                      <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 shrink-0">
                        {item.tags.join(' · ')}
                      </div>
                    )}
                  </div>

                  <p set:html={formatRichText(item.description)} class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal" />
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>

  <!-- Client-side hydration script for instant live Supabase data updates & tab filtering -->
  <script>
    import { getProjects, getShowcaseItems, formatRichText } from '../lib/supabase';

    function initFilterTabs() {
      const tabBtns = document.querySelectorAll('.project-tab-btn');
      const mainSection = document.getElementById('main-projects-section');
      const showcaseSection = document.getElementById('showcase-projects-section');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Reset all tabs to inactive terminal styling
          tabBtns.forEach((b) => {
            b.className = "project-tab-btn text-neutral-500 hover:text-[#1a1a1a] dark:hover:text-neutral-200 font-normal transition-colors duration-150 cursor-pointer flex items-center gap-1.5 group";
            const prompt = b.querySelector('.tab-prompt');
            if (prompt) {
              prompt.className = "tab-prompt text-emerald-500 font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-150";
            }
          });

          // Set clicked tab to active terminal styling
          btn.className = "project-tab-btn text-[#1a1a1a] dark:text-neutral-100 font-bold transition-colors duration-150 cursor-pointer flex items-center gap-1.5 group";
          const activePrompt = btn.querySelector('.tab-prompt');
          if (activePrompt) {
            activePrompt.className = "tab-prompt text-emerald-500 font-bold opacity-100";
          }

          // Perform filtering with smooth section visibility toggle & perfect spacing
          if (filter === 'all') {
            if (mainSection) { mainSection.style.display = 'block'; }
            if (showcaseSection) {
              showcaseSection.style.display = 'block';
              showcaseSection.className = "space-y-8 transition-all duration-200 border-t border-neutral-200 dark:border-neutral-800 pt-12 sm:pt-16 mt-12 sm:mt-16";
            }
          } else if (filter === 'main') {
            if (mainSection) { mainSection.style.display = 'block'; }
            if (showcaseSection) { showcaseSection.style.display = 'none'; }
          } else if (filter === 'side') {
            if (mainSection) { mainSection.style.display = 'none'; }
            if (showcaseSection) {
              showcaseSection.style.display = 'block';
              showcaseSection.className = "space-y-8 transition-all duration-200 mt-6 pt-0 border-t-0";
            }
          }
        });
      });
    }

    async function refreshProjectsPage() {
      try {
        const [projects, showcases] = await Promise.all([
          getProjects(),
          getShowcaseItems(),
        ]);

        const container = document.getElementById('projects-list');
        if (container && projects && projects.length > 0) {
          container.innerHTML = projects
            .map((project) => {
              const hasImage = Boolean(project.image_url);
              const hasLiveUrl = Boolean(project.live_url);
              const hasGithubUrl = Boolean(project.github_url);
              const tagStr = project.tags ? project.tags.join(' · ') : '';

              const liveLinkHtml = hasLiveUrl
                ? `<a href="${project.live_url}" target="_blank" rel="noopener noreferrer" class="link-slate">Live Demo ↗</a><span>/</span>`
                : '';
              const githubLinkHtml = hasGithubUrl
                ? `<a href="${project.github_url}" target="_blank" rel="noopener noreferrer" class="link-slate">GitHub ↗</a><span>/</span>`
                : '';

              if (hasImage) {
                return `
                <article class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="md:col-span-5">
                    <a href="/projects/${project.slug}" class="block overflow-hidden rounded-md border border-[#d0d0d0] dark:border-[#404040] group bg-neutral-900/90">
                      <img src="${project.image_url}" alt="${project.title}" class="w-full h-auto max-h-64 object-contain group-hover:scale-105 transition-transform duration-300 mx-auto" />
                    </a>
                  </div>
                  <div class="md:col-span-7 space-y-3">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                      <h2 class="text-base font-bold font-pixel">
                        <a href="/projects/${project.slug}" class="link-slate">${project.title}</a>
                      </h2>
                      <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                        <span>${project.date}</span>
                        <span>/</span>
                        ${liveLinkHtml}
                        ${githubLinkHtml}
                        <a href="/projects/${project.slug}" class="link-slate">View Case Study →</a>
                      </div>
                    </div>
                    <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${project.description}</p>
                    <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">${tagStr}</div>
                  </div>
                </article>`;
              } else {
                return `
                <article class="space-y-3 py-8 border-b border-[#d0d0d0] dark:border-[#404040] last:border-0">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                    <h2 class="text-base font-bold font-pixel">
                      <a href="/projects/${project.slug}" class="link-slate">${project.title}</a>
                    </h2>
                    <div class="flex items-center space-x-2.5 text-xs font-pixel text-neutral-500 shrink-0">
                      <span>${project.date}</span>
                      <span>/</span>
                      ${liveLinkHtml}
                      ${githubLinkHtml}
                      <a href="/projects/${project.slug}" class="link-slate">View Case Study →</a>
                    </div>
                  </div>
                  <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${project.description}</p>
                  <div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 pt-1">${tagStr}</div>
                </article>`;
              }
            })
            .join('');
        }

        const showcaseContainer = document.getElementById('showcase-list');
        if (showcaseContainer && showcases && showcases.length > 0) {
          showcaseContainer.innerHTML = showcases
            .map((item) => {
              const hasImage = Boolean(item.image_url);
              const tagStr = item.tags && item.tags.length > 0
                ? `<div class="font-pixel text-xs text-neutral-500 dark:text-neutral-400 shrink-0">${item.tags.join(' · ')}</div>`
                : '';
              const titleHtml = item.url
                ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="link-slate">${item.title} ↗</a>`
                : `<span>${item.title}</span>`;

              const imgHtml = hasImage
                ? `<div class="w-full aspect-[16/10] overflow-hidden rounded-xl border border-neutral-300 dark:border-neutral-800 bg-neutral-900/90 relative">${
                    item.url
                      ? `<a href="${item.url}" target="_blank" rel="noopener noreferrer" class="block w-full h-full"><img src="${item.image_url}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300 ease-out" /></a>`
                      : `<img src="${item.image_url}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300 ease-out" />`
                  }</div>`
                : '';

              return `
              <article class="flex flex-col space-y-4 group">
                ${imgHtml}
                <div class="space-y-2">
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5">
                    <h3 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-[#e8e8e8]">${titleHtml}</h3>
                    ${tagStr}
                  </div>
                  <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans font-normal">${formatRichText(item.description)}</p>
                </div>
              </article>`;
            })
            .join('');
        }
      } catch {
        // Keep pre-rendered HTML
      }
    }

    const runInit = () => {
      initFilterTabs();
      refreshProjectsPage();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runInit);
    } else {
      runInit();
    }

    document.addEventListener('astro:after-swap', runInit);
  </script>
</BaseLayout>
