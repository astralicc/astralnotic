---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/supabase';

const projects = await getProjects();
const adminKey = import.meta.env.PUBLIC_ADMIN_KEY || 'astralnoticastra7413ASTRALICC';
---

<BaseLayout
  title="Upload Project Assets — Supabase Storage"
  description="Upload project images directly to Supabase Storage."
>
  <div class="max-w-2xl mx-auto space-y-8">
    <!-- Header -->
    <div class="space-y-2 border-b border-[#d0d0d0] dark:border-[#404040] pb-6">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold tracking-tight text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
          Project Image Uploader
        </h1>
        <span class="text-[10px] font-pixel text-neutral-400 uppercase tracking-widest border border-neutral-300 dark:border-neutral-700 px-2 py-0.5 rounded">
          Admin Only
        </span>
      </div>
      <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Restricted administration route. Upload project images directly to Supabase Storage.
      </p>
    </div>

    <!-- Admin Authentication Lock Screen (Shown when locked) -->
    <div id="auth-lock-card" class="border border-neutral-300 dark:border-neutral-700 rounded-xl p-8 sm:p-12 bg-neutral-50/50 dark:bg-neutral-900/30 text-center space-y-4">
      <div class="w-12 h-12 rounded-full bg-neutral-200 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 flex items-center justify-center text-neutral-600 dark:text-neutral-300 mx-auto font-pixel text-lg">
        🔒
      </div>
      <div class="space-y-1">
        <h2 class="font-pixel text-sm font-bold text-[#1a1a1a] dark:text-white">Admin Authentication Required</h2>
        <p class="text-xs font-sans text-neutral-500">This uploader is protected. Enter your Admin Key to proceed.</p>
      </div>
      <form id="auth-form" class="max-w-xs mx-auto flex items-center space-x-2 pt-2">
        <input
          type="password"
          id="auth-key-input"
          placeholder="Enter Admin Key"
          class="flex-1 bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 rounded px-3 py-2 text-xs font-mono text-[#1a1a1a] dark:text-white focus:outline-none focus:ring-1 focus:ring-neutral-500"
        />
        <button
          type="submit"
          class="px-4 py-2 rounded bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-pixel text-xs font-bold hover:opacity-90 transition-opacity shrink-0"
        >
          Unlock
        </button>
      </form>
      <p id="auth-error" class="text-xs font-mono text-red-500 font-bold hidden">Invalid Admin Key!</p>
    </div>

    <!-- Drag & Drop Upload Container (Hidden until authenticated) -->
    <div id="uploader-wrapper" class="space-y-6 hidden" data-admin-key={adminKey}>
      <div
        id="drop-zone"
        class="border-2 border-dashed border-neutral-300 dark:border-neutral-700 hover:border-neutral-500 dark:hover:border-neutral-500 rounded-xl p-8 sm:p-12 text-center transition-all bg-neutral-50/50 dark:bg-neutral-900/30 cursor-pointer group flex flex-col items-center justify-center space-y-4"
      >
        <input
          type="file"
          id="file-input"
          accept="image/png, image/jpeg, image/webp, image/gif, image/svg+xml"
          class="hidden"
        />

        <div class="w-12 h-12 rounded-full bg-neutral-200 dark:bg-neutral-800 flex items-center justify-center text-neutral-600 dark:text-neutral-300 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
          </svg>
        </div>

        <div class="space-y-1">
          <p class="text-sm font-bold text-[#1a1a1a] dark:text-white font-pixel">
            Drag & drop an image here, or <span class="link-slate">browse</span>
          </p>
          <p class="text-xs text-neutral-500 font-sans">
            Supports PNG, JPG, WEBP, GIF, SVG (up to 10MB)
          </p>
        </div>
      </div>

      <!-- File Preview & Upload Status Card (Hidden by default) -->
      <div id="preview-card" class="hidden border border-neutral-300 dark:border-neutral-700 rounded-xl p-5 bg-neutral-100/60 dark:bg-neutral-900/60 space-y-4">
        <div class="flex items-center space-x-4">
          <img id="image-preview" src="" class="w-20 h-16 object-cover rounded border border-neutral-300 dark:border-neutral-700" />
          <div class="flex-1 min-w-0 font-pixel text-xs space-y-1">
            <p id="file-name" class="font-bold text-[#1a1a1a] dark:text-white truncate"></p>
            <p id="file-size" class="text-neutral-500 text-[11px]"></p>
          </div>
          <button
            id="clear-btn"
            class="text-xs font-pixel text-red-500 hover:text-red-600 px-2 py-1 rounded border border-red-200 dark:border-red-900/50"
          >
            Clear
          </button>
        </div>

        <!-- Optional Link to Existing Project -->
        <div class="space-y-1.5 pt-2 border-t border-neutral-300/40 dark:border-neutral-800">
          <label class="block font-pixel text-xs text-neutral-600 dark:text-neutral-400">
            Attach Image to Project (Optional):
          </label>
          <select
            id="project-selector"
            class="w-full bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 rounded px-3 py-2 text-xs font-pixel text-[#1a1a1a] dark:text-neutral-200 focus:outline-none focus:ring-1 focus:ring-neutral-500"
          >
            <option value="">-- Don't attach (Upload URL only) --</option>
            {
              projects.map((p) => (
                <option value={p.slug}>{p.title} ({p.slug})</option>
              ))
            }
          </select>
        </div>

        <!-- Action Button -->
        <button
          id="upload-btn"
          class="w-full py-2.5 px-4 rounded-lg bg-[#1a1a1a] dark:bg-white text-white dark:text-[#1a1a1a] font-pixel text-xs font-bold hover:opacity-90 transition-opacity flex items-center justify-center space-x-2 shadow-md"
        >
          <span>Upload Image to Supabase</span>
        </button>
      </div>

      <!-- Upload Success Output Card (Hidden by default) -->
      <div id="result-card" class="hidden border border-emerald-500/40 bg-emerald-500/10 rounded-xl p-5 space-y-3">
        <div class="flex items-center space-x-2 text-emerald-600 dark:text-emerald-400 font-pixel text-xs font-bold">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Upload Successful!</span>
        </div>

        <div class="space-y-1">
          <span class="text-[11px] font-pixel text-neutral-500">Public CDN URL:</span>
          <div class="flex items-center space-x-2">
            <input
              type="text"
              id="public-url-input"
              readonly
              class="flex-1 bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded px-3 py-2 text-xs font-mono text-neutral-800 dark:text-neutral-200 select-all focus:outline-none"
            />
            <button
              id="copy-btn"
              class="px-3 py-2 rounded bg-neutral-800 hover:bg-neutral-700 text-white font-pixel text-xs transition-colors shrink-0"
            >
              Copy URL
            </button>
          </div>
        </div>

        <p id="linked-status" class="text-xs font-sans text-neutral-500 dark:text-neutral-400 italic hidden"></p>
      </div>

      <!-- Storage Bucket Instructions Alert -->
      <div class="border border-neutral-300 dark:border-neutral-800 rounded-xl p-5 bg-neutral-100/40 dark:bg-neutral-900/40 space-y-3 font-sans text-xs text-neutral-600 dark:text-neutral-400">
        <div class="font-pixel font-bold text-neutral-900 dark:text-neutral-200 text-xs flex items-center space-x-2">
          <span>⚙️ Supabase Storage Setup Quick Reference</span>
        </div>
        <p>
          Before uploading, ensure your Supabase project has a public bucket named <code class="font-pixel text-[11px] text-neutral-900 dark:text-neutral-200 font-bold">portfolio-images</code>.
        </p>
        <details class="cursor-pointer">
          <summary class="font-pixel text-[11px] link-slate">View SQL Bucket Setup Script</summary>
          <pre class="mt-2 p-3 rounded bg-neutral-900 text-neutral-200 font-mono text-[11px] overflow-x-auto"><code>-- Run in Supabase SQL Editor
INSERT INTO storage.buckets (id, name, public)
VALUES ('portfolio-images', 'portfolio-images', true)
ON CONFLICT (id) DO NOTHING;

CREATE POLICY "Public Read Portfolio Images"
ON storage.objects FOR SELECT
USING (bucket_id = 'portfolio-images');

CREATE POLICY "Public Upload Portfolio Images"
ON storage.objects FOR INSERT
WITH CHECK (bucket_id = 'portfolio-images');</code></pre>
        </details>
      </div>
    </div>
  </div>

  <!-- Client-side Upload & Auth Logic -->
  <script>
    import { uploadProjectImage, updateProjectImage } from '../lib/supabase';

    const uploaderWrapper = document.getElementById('uploader-wrapper');
    const authLockCard = document.getElementById('auth-lock-card');
    const authForm = document.getElementById('auth-form');
    const authKeyInput = document.getElementById('auth-key-input') as HTMLInputElement;
    const authError = document.getElementById('auth-error');

    const targetAdminKey = uploaderWrapper?.getAttribute('data-admin-key') || 'astralnoticastra7413ASTRALICC';

    const unlockUploader = () => {
      authLockCard?.classList.add('hidden');
      uploaderWrapper?.classList.remove('hidden');
      sessionStorage.setItem('admin_authenticated', 'true');
    };

    // Check if authenticated via URL param (?key=...) or previous session
    const urlParams = new URLSearchParams(window.location.search);
    const urlKey = urlParams.get('key') || window.location.hash.replace('#', '');

    if (sessionStorage.getItem('admin_authenticated') === 'true' || urlKey === targetAdminKey) {
      unlockUploader();
    }

    authForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredKey = authKeyInput?.value?.trim();
      if (enteredKey === targetAdminKey) {
        authError?.classList.add('hidden');
        unlockUploader();
      } else {
        authError?.classList.remove('hidden');
        if (authKeyInput) authKeyInput.value = '';
      }
    });

    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const previewCard = document.getElementById('preview-card');
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
    const fileNameEl = document.getElementById('file-name');
    const fileSizeEl = document.getElementById('file-size');
    const clearBtn = document.getElementById('clear-btn');
    const uploadBtn = document.getElementById('upload-btn');
    const projectSelector = document.getElementById('project-selector') as HTMLSelectElement;
    const resultCard = document.getElementById('result-card');
    const publicUrlInput = document.getElementById('public-url-input') as HTMLInputElement;
    const copyBtn = document.getElementById('copy-btn');
    const linkedStatus = document.getElementById('linked-status');

    let selectedFile: File | null = null;

    const handleFileSelect = (file: File) => {
      if (!file.type.startsWith('image/')) {
        alert('Please select an image file (.png, .jpg, .webp, .gif, .svg)');
        return;
      }

      selectedFile = file;
      if (fileNameEl) fileNameEl.textContent = file.name;
      if (fileSizeEl) fileSizeEl.textContent = `${(file.size / 1024).toFixed(1)} KB`;

      const reader = new FileReader();
      reader.onload = (e) => {
        if (imagePreview && e.target?.result) {
          imagePreview.src = e.target.result as string;
        }
      };
      reader.readAsDataURL(file);

      previewCard?.classList.remove('hidden');
      resultCard?.classList.add('hidden');
    };

    dropZone?.addEventListener('click', () => fileInput?.click());

    fileInput?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files.length > 0) {
        handleFileSelect(files[0]);
      }
    });

    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-neutral-500');
    });

    dropZone?.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-neutral-500');
    });

    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-neutral-500');
      if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
        handleFileSelect(e.dataTransfer.files[0]);
      }
    });

    clearBtn?.addEventListener('click', () => {
      selectedFile = null;
      if (fileInput) fileInput.value = '';
      previewCard?.classList.add('hidden');
      resultCard?.classList.add('hidden');
    });

    uploadBtn?.addEventListener('click', async () => {
      if (!selectedFile) return;

      uploadBtn.setAttribute('disabled', 'true');
      uploadBtn.innerHTML = '<span>Uploading to Supabase Storage...</span>';

      const { publicUrl, error } = await uploadProjectImage(selectedFile);

      if (error || !publicUrl) {
        alert(`Upload Failed: ${error || 'Unknown error'}\n\nPlease verify your 'portfolio-images' bucket is created in Supabase Storage.`);
        uploadBtn.removeAttribute('disabled');
        uploadBtn.innerHTML = '<span>Upload Image to Supabase</span>';
        return;
      }

      if (publicUrlInput) publicUrlInput.value = publicUrl;
      resultCard?.classList.remove('hidden');

      const selectedSlug = projectSelector?.value;
      if (selectedSlug) {
        const { success, error: updateError } = await updateProjectImage(selectedSlug, publicUrl);
        if (linkedStatus) {
          linkedStatus.classList.remove('hidden');
          if (success) {
            linkedStatus.textContent = `✓ Linked image_url to project '${selectedSlug}' in Supabase database!`;
            linkedStatus.className = 'text-xs font-sans text-emerald-600 dark:text-emerald-400 font-medium';
          } else {
            linkedStatus.textContent = `⚠️ Image uploaded, but failed to link project '${selectedSlug}': ${updateError}`;
            linkedStatus.className = 'text-xs font-sans text-amber-600 dark:text-amber-400';
          }
        }
      } else if (linkedStatus) {
        linkedStatus.classList.add('hidden');
      }

      uploadBtn.removeAttribute('disabled');
      uploadBtn.innerHTML = '<span>Upload Image to Supabase</span>';
    });

    copyBtn?.addEventListener('click', () => {
      if (!publicUrlInput?.value) return;
      navigator.clipboard.writeText(publicUrlInput.value);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = 'Copy URL';
      }, 2000);
    });
  </script>
</BaseLayout>
