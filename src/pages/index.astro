---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getCurrentlyItems, getProfile, type ConnectLink } from '../lib/supabase';

const profile = await getProfile();
const allProjects = await getProjects();
const recentProjects = allProjects.slice(0, 3);
const currentlyItems = await getCurrentlyItems();
---

<BaseLayout
  title={`${profile.name} — ${profile.roles.join(' & ')}`}
  description={`Personal developer website of ${profile.name}.`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Asymmetric 2-Column Layout (Left 1/3 Identity & Context, Right 2/3 Bio & Selected Works) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-start">
      <!-- Left Column (1/3 Width — Personal Identity, Connect & Currently) -->
      <div class="md:col-span-4 space-y-8">
        <!-- Cute Cat Doodle Frame with Animated Line Scribble -->
        <div class="w-full sm:w-56 p-4 rounded border border-neutral-300 dark:border-neutral-700 flex flex-col items-center justify-center relative group">
          <!-- SVG Filter for Hand-Drawn Line Scribble / Wiggle -->
          <svg class="absolute w-0 h-0 pointer-events-none" aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
            <defs>
              <filter id="cat-scribble-filter" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" result="noise">
                  <animate
                    attributeName="baseFrequency"
                    dur="0.75s"
                    values="0.03; 0.055; 0.025; 0.05; 0.03"
                    repeatCount="indefinite"
                  />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="2" xChannelSelector="R" yChannelSelector="G" />
              </filter>
            </defs>
          </svg>

          <div class="w-44 h-28 flex items-center justify-center overflow-hidden">
            <!-- Original Cat Avatar PNG (Transparent Background, Preserved 16:9 Proportions) -->
            <img
              src="/assets/cat-avatar.png"
              alt="Cat Avatar"
              class="cat-scribble-anim w-full h-full object-contain dark:invert transition-all duration-150"
            />
          </div>
        </div>

        <!-- Name (Departure Mono) & Roles (Uncut Sans) -->
        <div>
          <!-- Name in Departure Mono -->
          <h1 id="profile-name" class="font-pixel font-bold text-xl text-[#1a1a1a] dark:text-white tracking-tight">
            {profile.name}
          </h1>
          <!-- Roles with Line Breaks & Spring Popping-Out Micro-Interactions -->
          <div id="profile-roles" class="font-sans text-xs text-neutral-500 dark:text-neutral-400 mt-1.5 flex flex-col space-y-1.5 items-start">
            {
              profile.roles.map((role: string) => {
                const lower = role.toLowerCase();
                const isBackend = lower.includes('backend');
                const isGame = lower.includes('game');

                if (isBackend) {
                  return (
                    <div class="group/role relative block cursor-pointer transition-colors duration-150 hover:text-emerald-600 dark:hover:text-emerald-400 font-medium">
                      <span>{role}</span>
                      <!-- Backend Code & Server Confetti Popburst Particles -->
                      <span class="pointer-events-none absolute inset-0 z-50">
                        <span class="pop-particle pop-1 bg-neutral-950 border border-emerald-500/50 text-emerald-400 font-pixel text-[10px] px-1.5 py-0.5 rounded shadow-xl">&lt;/&gt;</span>
                        <span class="pop-particle pop-5 bg-emerald-950 border border-emerald-500/70 text-emerald-300 font-pixel text-[10px] px-2 py-0.5 rounded shadow-2xl font-bold flex items-center space-x-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span><span>200 OK</span></span>
                        <span class="pop-particle pop-2 bg-neutral-950 border border-emerald-500/50 text-emerald-400 font-pixel text-[10px] px-1.5 py-0.5 rounded shadow-xl">&#123;&nbsp;&#125;</span>
                        <span class="pop-particle pop-3 bg-neutral-950 border border-neutral-800 text-neutral-400 font-mono text-[9px] px-1.5 py-0.5 rounded">1.2ms</span>
                        <span class="pop-particle pop-4 bg-neutral-950 border border-neutral-800 text-emerald-400 font-pixel text-[9px] px-1.5 py-0.5 rounded">ssh://</span>
                      </span>
                    </div>
                  );
                }

                if (isGame) {
                  return (
                    <div class="group/role relative block cursor-pointer transition-colors duration-150 hover:text-amber-600 dark:hover:text-amber-400 font-medium">
                      <span>{role}</span>
                      <!-- Game Designer Arcade & Retro Confetti Popburst Particles -->
                      <span class="pointer-events-none absolute inset-0 z-50">
                        <span class="pop-particle pop-1 bg-amber-950 border border-amber-500/50 text-amber-400 font-pixel text-[11px] px-1.5 py-0.5 rounded shadow-xl">🎮</span>
                        <span class="pop-particle pop-5 bg-amber-500 text-neutral-950 font-pixel text-[10px] px-2 py-0.5 rounded shadow-2xl font-black flex items-center space-x-1"><span>✦</span><span>+100 XP</span></span>
                        <span class="pop-particle pop-2 bg-amber-950 border border-amber-500/50 text-amber-300 font-pixel text-[11px] px-1.5 py-0.5 rounded shadow-xl">👾</span>
                        <span class="pop-particle pop-3 bg-neutral-950 border border-amber-500/40 text-amber-400 font-pixel text-[9px] px-1.5 py-0.5 rounded font-bold">LVL 99</span>
                        <span class="pop-particle pop-4 bg-neutral-950 border border-amber-500/40 text-amber-300 font-pixel text-[11px] px-1.5 py-0.5 rounded">🏆</span>
                      </span>
                    </div>
                  );
                }

                return <div class="block leading-relaxed">{role}</div>;
              })
            }
          </div>
        </div>

        <!-- CONNECT Section (Dynamically Fetched from Supabase) -->
        <div class="space-y-2 font-pixel text-xs">
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2 font-pixel">
            connect
          </div>
          <div id="connect-links" class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-neutral-600 dark:text-neutral-400">
            {
              profile.connect_links.map((link: ConnectLink, index: number) => {
                const isMail = link.url.startsWith('mailto:');
                const isLast = index === profile.connect_links.length - 1;
                return (
                  <>
                    <a
                      href={link.url}
                      target={isMail ? undefined : '_blank'}
                      rel={isMail ? undefined : 'noopener noreferrer'}
                      class="link-slate"
                    >
                      {link.label} ↗
                    </a>
                    {!isLast && <span class="text-neutral-400 dark:text-neutral-600">/</span>}
                  </>
                );
              })
            }
          </div>
        </div>

        <!-- CURRENTLY Section (Dynamically Fetched from Supabase) -->
        <div class="space-y-2">
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2 font-pixel">
            currently
          </div>
          <ul id="currently-list" class="space-y-2 text-xs">
            {
              currentlyItems.map((item) => (
                <li class="leading-relaxed">
                  <span class="font-pixel text-neutral-800 dark:text-neutral-200 font-medium">
                    {item.action}
                  </span>
                  <span class="text-neutral-400 dark:text-neutral-600 mx-1">—</span>
                  <span class="font-sans text-neutral-600 dark:text-neutral-400">
                    {item.detail}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right Column (2/3 Width — Bio & Selected Works) -->
      <div class="md:col-span-8 space-y-8 pt-4">
        <!-- Bio Header -->
        <h2 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-white">
          Hi! 👋
        </h2>

        <!-- Bio Paragraphs (Supports HTML <strong> tags for bolding) -->
        <div id="profile-bio" class="space-y-4 text-sm sm:text-base leading-relaxed text-[#1a1a1a] dark:text-neutral-200 font-sans">
          {
            Array.isArray(profile.bio) ? (
              profile.bio.map((paragraph: string) => <p set:html={paragraph} />)
            ) : (
              <p set:html={profile.bio} />
            )
          }
        </div>

        <!-- Hairline Divider -->
        <div class="border-t border-[#d0d0d0] dark:border-[#404040] pt-8 mt-8">
          <!-- Recent Projects Section (Dynamically Fetched & Perfectly Aligned Grid) -->
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <!-- Recent Projects (Capitalized) -->
              <h3 class="text-xs font-pixel text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
                Recent Projects
              </h3>
              <a href="/projects" class="font-sans text-xs link-slate">
                view all →
              </a>
            </div>

            <!-- Quiet Project List (Perfect 12-column grid alignment) -->
            <div id="recent-projects-list" class="space-y-4">
              {
                recentProjects.map((project) => {
                  const tagStr = project.tags.join(' · ');
                  return (
                    <div class="grid grid-cols-1 sm:grid-cols-12 items-baseline gap-2 py-2 text-sm border-b border-neutral-300/30 dark:border-neutral-800/60 pb-3 last:border-0">
                      <div class="sm:col-span-5">
                        <a
                          href={`/projects/${project.slug}`}
                          class="font-pixel font-bold link-slate block"
                        >
                          {project.title}
                        </a>
                      </div>

                      <div class="sm:col-span-7 sm:text-right font-pixel text-xs text-neutral-500 dark:text-neutral-400">
                        {tagStr}
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side hydration script for instant live Supabase data updates -->
  <script>
    import { getCurrentlyItems, getProfile, getProjects, type ConnectLink } from '../lib/supabase';

    async function refreshLiveData() {
      try {
        const [profile, items, projects] = await Promise.all([
          getProfile(),
          getCurrentlyItems(),
          getProjects(),
        ]);

        if (profile) {
          const nameEl = document.getElementById('profile-name');
          if (nameEl && profile.name) nameEl.textContent = profile.name;

          const rolesEl = document.getElementById('profile-roles');
          if (rolesEl && profile.roles) {
            rolesEl.innerHTML = profile.roles
              .map((r: string) => {
                const lower = r.toLowerCase();
                if (lower.includes('backend')) {
                  return `
                  <div class="group/role relative block cursor-pointer transition-colors duration-150 hover:text-emerald-600 dark:hover:text-emerald-400 font-medium">
                    <span>${r}</span>
                    <span class="pointer-events-none absolute inset-0 z-50">
                      <span class="pop-particle pop-1 bg-neutral-950 border border-emerald-500/50 text-emerald-400 font-pixel text-[10px] px-1.5 py-0.5 rounded shadow-xl">&lt;/&gt;</span>
                      <span class="pop-particle pop-5 bg-emerald-950 border border-emerald-500/70 text-emerald-300 font-pixel text-[10px] px-2 py-0.5 rounded shadow-2xl font-bold flex items-center space-x-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span><span>200 OK</span></span>
                      <span class="pop-particle pop-2 bg-neutral-950 border border-emerald-500/50 text-emerald-400 font-pixel text-[10px] px-1.5 py-0.5 rounded shadow-xl">&#123;&nbsp;&#125;</span>
                      <span class="pop-particle pop-3 bg-neutral-950 border border-neutral-800 text-neutral-400 font-mono text-[9px] px-1.5 py-0.5 rounded">1.2ms</span>
                      <span class="pop-particle pop-4 bg-neutral-950 border border-neutral-800 text-emerald-400 font-pixel text-[9px] px-1.5 py-0.5 rounded">ssh://</span>
                    </span>
                  </div>`;
                }
                if (lower.includes('game')) {
                  return `
                  <div class="group/role relative block cursor-pointer transition-colors duration-150 hover:text-amber-600 dark:hover:text-amber-400 font-medium">
                    <span>${r}</span>
                    <span class="pointer-events-none absolute inset-0 z-50">
                      <span class="pop-particle pop-1 bg-amber-950 border border-amber-500/50 text-amber-400 font-pixel text-[11px] px-1.5 py-0.5 rounded shadow-xl">🎮</span>
                      <span class="pop-particle pop-5 bg-amber-500 text-neutral-950 font-pixel text-[10px] px-2 py-0.5 rounded shadow-2xl font-black flex items-center space-x-1"><span>✦</span><span>+100 XP</span></span>
                      <span class="pop-particle pop-2 bg-amber-950 border border-amber-500/50 text-amber-300 font-pixel text-[11px] px-1.5 py-0.5 rounded shadow-xl">👾</span>
                      <span class="pop-particle pop-3 bg-neutral-950 border border-amber-500/40 text-amber-400 font-pixel text-[9px] px-1.5 py-0.5 rounded font-bold">LVL 99</span>
                      <span class="pop-particle pop-4 bg-neutral-950 border border-amber-500/40 text-amber-300 font-pixel text-[11px] px-1.5 py-0.5 rounded">🏆</span>
                    </span>
                  </div>`;
                }
                return `<div class="block leading-relaxed">${r}</div>`;
              })
              .join('');
          }

          const connectEl = document.getElementById('connect-links');
          if (connectEl && profile.connect_links && profile.connect_links.length > 0) {
            connectEl.innerHTML = profile.connect_links
              .map((link: ConnectLink, idx: number) => {
                const isMail = link.url.startsWith('mailto:');
                const isLast = idx === profile.connect_links.length - 1;
                const linkHtml = `<a href="${link.url}" ${isMail ? '' : 'target="_blank" rel="noopener noreferrer"'} class="link-slate">${link.label} ↗</a>`;
                return isLast ? linkHtml : `${linkHtml}<span class="text-neutral-400 dark:text-neutral-600">/</span>`;
              })
              .join('');
          }

          const bioEl = document.getElementById('profile-bio');
          if (bioEl && profile.bio) {
            if (Array.isArray(profile.bio)) {
              bioEl.innerHTML = profile.bio
                .map((p: string) => `<p>${p}</p>`)
                .join('');
            } else {
              bioEl.innerHTML = `<p>${profile.bio}</p>`;
            }
          }
        }

        const container = document.getElementById('currently-list');
        if (container && items && items.length > 0) {
          container.innerHTML = items
            .map(
              (item) => `
            <li class="leading-relaxed">
              <span class="font-pixel text-neutral-800 dark:text-neutral-200 font-medium">${item.action}</span>
              <span class="text-neutral-400 dark:text-neutral-600 mx-1">—</span>
              <span class="font-sans text-neutral-600 dark:text-neutral-400">${item.detail}</span>
            </li>`
            )
            .join('');
        }

        const recentProjectsEl = document.getElementById('recent-projects-list');
        if (recentProjectsEl && projects && projects.length > 0) {
          const recentList = projects.slice(0, 3);
          recentProjectsEl.innerHTML = recentList
            .map((project) => {
              const tagStr = project.tags ? project.tags.join(' · ') : '';
              return `
              <div class="grid grid-cols-1 sm:grid-cols-12 items-baseline gap-2 py-2 text-sm border-b border-neutral-300/30 dark:border-neutral-800/60 pb-3 last:border-0">
                <div class="sm:col-span-5">
                  <a href="/projects/${project.slug}" class="font-pixel font-bold link-slate block">
                    ${project.title}
                  </a>
                </div>
                <div class="sm:col-span-7 sm:text-right font-pixel text-xs text-neutral-500 dark:text-neutral-400">
                  ${tagStr}
                </div>
              </div>`;
            })
            .join('');
        }
      } catch {
        // Keep pre-rendered fallback HTML
      }
    }

    refreshLiveData();
    document.addEventListener('astro:after-swap', refreshLiveData);
  </script>

  <style>
    .cat-scribble-anim {
      filter: url(#cat-scribble-filter);
      animation: cat-scribble-wiggle 0.75s steps(2, end) infinite;
      will-change: transform, filter;
      transition: filter 0.2s ease, transform 0.2s ease;
    }

    /* Invert black lines to white in Dark Mode while preserving the SVG turbulence filter */
    :global(.dark) .cat-scribble-anim {
      filter: invert(1) url(#cat-scribble-filter);
    }

    /* Stop scribble animation and clear turbulence filter on hover while maintaining theme line color */
    .group:hover .cat-scribble-anim,
    .cat-scribble-anim:hover {
      animation-play-state: paused;
      filter: none;
      transform: scale(1) rotate(0deg) translate(0px, 0px);
    }

    :global(.dark) .group:hover .cat-scribble-anim,
    :global(.dark) .cat-scribble-anim:hover {
      filter: invert(1);
    }

    @keyframes cat-scribble-wiggle {
      0% {
        transform: scale(1) rotate(0deg) translate(0px, 0px);
      }
      25% {
        transform: scale(1.012) rotate(-0.5deg) translate(-0.4px, 0.4px);
      }
      50% {
        transform: scale(0.992) rotate(0.5deg) translate(0.4px, -0.4px);
      }
      75% {
        transform: scale(1.008) rotate(-0.3deg) translate(0.3px, 0.3px);
      }
      100% {
        transform: scale(1) rotate(0deg) translate(0px, 0px);
      }
    }

    /* Confetti Particle Pop-Burst Hover Animations */
    .pop-particle {
      position: absolute;
      top: 50%;
      left: 50%;
      opacity: 0;
      pointer-events: none;
      white-space: nowrap;
      will-change: transform, opacity;
    }

    .group\/role:hover .pop-1 {
      animation: particle-burst-top-left 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .group\/role:hover .pop-2 {
      animation: particle-burst-top-right 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .group\/role:hover .pop-3 {
      animation: particle-burst-bottom-left 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .group\/role:hover .pop-4 {
      animation: particle-burst-bottom-right 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .group\/role:hover .pop-5 {
      animation: particle-burst-top-center 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes particle-burst-top-left {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0deg); }
      50% { opacity: 1; transform: translate(-65px, -32px) scale(1.1) rotate(-14deg); }
      100% { opacity: 0; transform: translate(-85px, -45px) scale(0.7) rotate(-28deg); }
    }

    @keyframes particle-burst-top-right {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0deg); }
      50% { opacity: 1; transform: translate(55px, -32px) scale(1.1) rotate(14deg); }
      100% { opacity: 0; transform: translate(75px, -45px) scale(0.7) rotate(28deg); }
    }

    @keyframes particle-burst-bottom-left {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0deg); }
      50% { opacity: 1; transform: translate(-55px, 14px) scale(1.1) rotate(-10deg); }
      100% { opacity: 0; transform: translate(-75px, 22px) scale(0.7) rotate(-22deg); }
    }

    @keyframes particle-burst-bottom-right {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2) rotate(0deg); }
      50% { opacity: 1; transform: translate(50px, 14px) scale(1.1) rotate(10deg); }
      100% { opacity: 0; transform: translate(70px, 22px) scale(0.7) rotate(22deg); }
    }

    @keyframes particle-burst-top-center {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
      50% { opacity: 1; transform: translate(-50%, -42px) scale(1.15); }
      100% { opacity: 0; transform: translate(-50%, -58px) scale(0.8); }
    }
  </style>
</BaseLayout>
