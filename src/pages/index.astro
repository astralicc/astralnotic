---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getCurrentlyItems } from '../lib/supabase';

const allProjects = await getProjects();
const recentProjects = allProjects.slice(0, 3);
const currentlyItems = await getCurrentlyItems();

const roles = [
  "senior frontend engineer",
  "ui/ux architect",
];
---

<BaseLayout
  title="alex chen — senior frontend engineer & ui/ux architect"
  description="Personal developer website of Alex Chen."
>
  <div class="max-w-4xl mx-auto">
    <!-- Asymmetric 2-Column Layout (Left 1/3 Identity & Context, Right 2/3 Bio & Selected Works) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-start">
      <!-- Left Column (1/3 Width — Personal Identity, Connect & Currently) -->
      <div class="md:col-span-4 space-y-8">
        <!-- Cute Cat Doodle Frame -->
        <div class="w-full sm:w-56 p-4 rounded border border-neutral-300 dark:border-neutral-700 flex flex-col items-center justify-center">
          <div class="w-40 h-36 flex items-center justify-center overflow-hidden">
            <img
              src="/assets/cat-avatar.png"
              alt="Alex Cat Avatar"
              class="w-full h-full object-contain mix-blend-multiply dark:mix-blend-screen dark:invert transition-all duration-150"
            />
          </div>
        </div>

        <!-- Name (Departure Mono) & Roles (Uncut Sans) -->
        <div>
          <!-- Alex Chen in Departure Mono -->
          <h1 class="font-pixel font-bold text-xl text-[#1a1a1a] dark:text-white tracking-tight">
            Alex Chen
          </h1>
          <!-- Roles in Uncut Sans -->
          <div class="font-sans text-xs text-neutral-500 dark:text-neutral-400 mt-1 space-y-0.5">
            {
              roles.map((role) => (
                <div class="leading-snug">{role}</div>
              ))
            }
          </div>
        </div>

        <!-- CONNECT Section -->
        <div class="space-y-2 font-pixel text-xs">
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2 font-pixel">
            connect
          </div>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-neutral-600 dark:text-neutral-400">
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="link-slate">
              GitHub ↗
            </a>
            <span class="text-neutral-400 dark:text-neutral-600">/</span>
            <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="link-slate">
              Twitter ↗
            </a>
            <span class="text-neutral-400 dark:text-neutral-600">/</span>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="link-slate">
              LinkedIn ↗
            </a>
            <span class="text-neutral-400 dark:text-neutral-600">/</span>
            <a href="mailto:alex@example.com" class="link-slate">
              Email ↗
            </a>
          </div>
        </div>

        <!-- CURRENTLY Section (Dynamically Fetched from Supabase) -->
        <div class="space-y-2">
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2 font-pixel">
            currently
          </div>
          <ul id="currently-list" class="space-y-2 text-xs">
            {
              currentlyItems.map((item) => (
                <li class="leading-relaxed">
                  <span class="font-pixel text-neutral-800 dark:text-neutral-200 font-medium">
                    {item.action}
                  </span>
                  <span class="text-neutral-400 dark:text-neutral-600 mx-1">—</span>
                  <span class="font-sans text-neutral-600 dark:text-neutral-400">
                    {item.detail}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right Column (2/3 Width — Bio & Selected Works) -->
      <div class="md:col-span-8 space-y-8 pt-4">
        <!-- Bio Header -->
        <h2 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-white">
          Hi! 👋
        </h2>

        <!-- Bio Paragraphs (High-contrast text with bold company names — NO green highlights) -->
        <div class="space-y-4 text-sm sm:text-base leading-relaxed text-[#1a1a1a] dark:text-neutral-200 font-sans">
          <p>
            I'm Alex, a frontend engineer and creative technologist based in San Francisco. Currently, I'm leading web application architecture and design systems at <strong class="font-semibold text-[#1a1a1a] dark:text-white">V6 Studio</strong>, and previously helped build core UI component engines at <strong class="font-semibold text-[#1a1a1a] dark:text-white">Astro Core</strong>.
          </p>
          <p>
            I specialize in zero-runtime CSS tokens, React 19 concurrent rendering pipelines, and accessible WCAG 2.1 component primitives. Outside of work, I spend time drawing, tinkering with open-source utilities, and exploring minimalist web design.
          </p>
        </div>

        <!-- Hairline Divider -->
        <div class="border-t border-[#d0d0d0] dark:border-[#404040] pt-8 mt-8">
          <!-- Recent Projects Section (Dynamically Fetched from Supabase) -->
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <!-- Recent Projects (Capitalized) -->
              <h3 class="text-xs font-pixel text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
                Recent Projects
              </h3>
              <a href="/projects" class="font-sans text-xs link-slate">
                view all →
              </a>
            </div>

            <!-- Quiet Project List (Clean text rows with project title on left & plain-text tags on right) -->
            <div class="space-y-4">
              {
                recentProjects.map((project) => {
                  const tagStr = project.tags.join(' · ');
                  return (
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 py-1 text-sm border-b border-neutral-300/30 dark:border-neutral-800/60 pb-3 last:border-0">
                      <a
                        href={`/projects/${project.slug}`}
                        class="font-pixel font-bold link-slate"
                      >
                        {project.title}
                      </a>

                      <span class="font-pixel text-xs text-neutral-500 dark:text-neutral-400">
                        {tagStr}
                      </span>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side hydration script for instant live Supabase data updates -->
  <script>
    import { getCurrentlyItems } from '../lib/supabase';

    async function refreshCurrently() {
      try {
        const items = await getCurrentlyItems();
        const container = document.getElementById('currently-list');
        if (container && items && items.length > 0) {
          container.innerHTML = items
            .map(
              (item) => `
            <li class="leading-relaxed">
              <span class="font-pixel text-neutral-800 dark:text-neutral-200 font-medium">${item.action}</span>
              <span class="text-neutral-400 dark:text-neutral-600 mx-1">—</span>
              <span class="font-sans text-neutral-600 dark:text-neutral-400">${item.detail}</span>
            </li>`
            )
            .join('');
        }
      } catch {
        // keep pre-rendered html
      }
    }

    refreshCurrently();
    document.addEventListener('astro:after-swap', refreshCurrently);
  </script>
</BaseLayout>
