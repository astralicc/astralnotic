---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getCurrentlyItems, getProfile, type ConnectLink } from '../lib/supabase';

const profile = await getProfile();
const allProjects = await getProjects();
const recentProjects = allProjects.slice(0, 3);
const currentlyItems = await getCurrentlyItems();
---

<BaseLayout
  title={`${profile.name} — ${profile.roles.join(' & ')}`}
  description={`Personal developer website of ${profile.name}.`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Asymmetric 2-Column Layout (Left 1/3 Identity & Context, Right 2/3 Bio & Selected Works) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-start">
      <!-- Left Column (1/3 Width — Personal Identity, Connect & Currently) -->
      <div class="md:col-span-4 space-y-8">
        <!-- Cute Cat Doodle Frame with Animated Line Scribble -->
        <div class="w-full sm:w-56 p-4 rounded border border-neutral-300 dark:border-neutral-700 flex flex-col items-center justify-center relative group bg-neutral-50/50 dark:bg-neutral-900/40">
          <!-- SVG Filter for Hand-Drawn Line Scribble / Wiggle -->
          <svg class="absolute w-0 h-0 pointer-events-none" aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
            <defs>
              <filter id="cat-scribble-filter" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" result="noise">
                  <animate
                    attributeName="baseFrequency"
                    dur="0.35s"
                    values="0.03; 0.07; 0.02; 0.06; 0.04"
                    repeatCount="indefinite"
                  />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.5" xChannelSelector="R" yChannelSelector="G" />
              </filter>
            </defs>
          </svg>

          <div class="w-40 h-32 flex items-center justify-center overflow-hidden">
            <!-- Inline Sharp Vector Cat Doodle (No mix-blend hack needed, works 100% in light & dark mode) -->
            <svg
              viewBox="0 0 200 130"
              class="cat-scribble-anim w-36 h-28 text-neutral-900 dark:text-neutral-100 fill-none stroke-current"
              stroke-width="5.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <!-- Cat Head Contour -->
              <path d="M 42 38 Q 30 14 24 18 Q 18 42 16 58 Q 14 98 100 104 Q 186 98 184 58 Q 182 42 176 18 Q 170 14 158 38 Q 100 32 42 38 Z" />
              <!-- Left Eye -->
              <circle cx="74" cy="62" r="4.5" class="fill-current stroke-none" />
              <!-- Right Eye -->
              <circle cx="126" cy="62" r="4.5" class="fill-current stroke-none" />
              <!-- Cute 'V' Mouth -->
              <path d="M 90 74 L 100 84 L 110 74" stroke-width="5" />
            </svg>
          </div>
        </div>

        <!-- Name (Departure Mono) & Roles (Uncut Sans) -->
        <div>
          <!-- Name in Departure Mono -->
          <h1 id="profile-name" class="font-pixel font-bold text-xl text-[#1a1a1a] dark:text-white tracking-tight">
            {profile.name}
          </h1>
          <!-- Roles in Uncut Sans -->
          <div id="profile-roles" class="font-sans text-xs text-neutral-500 dark:text-neutral-400 mt-1 space-y-0.5">
            {
              profile.roles.map((role: string) => (
                <div class="leading-snug">{role}</div>
              ))
            }
          </div>
        </div>

        <!-- CONNECT Section (Dynamically Fetched from Supabase) -->
        <div class="space-y-2 font-pixel text-xs">
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2 font-pixel">
            connect
          </div>
          <div id="connect-links" class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-neutral-600 dark:text-neutral-400">
            {
              profile.connect_links.map((link: ConnectLink, index: number) => {
                const isMail = link.url.startsWith('mailto:');
                const isLast = index === profile.connect_links.length - 1;
                return (
                  <>
                    <a
                      href={link.url}
                      target={isMail ? undefined : '_blank'}
                      rel={isMail ? undefined : 'noopener noreferrer'}
                      class="link-slate"
                    >
                      {link.label} ↗
                    </a>
                    {!isLast && <span class="text-neutral-400 dark:text-neutral-600">/</span>}
                  </>
                );
              })
            }
          </div>
        </div>

        <!-- CURRENTLY Section (Dynamically Fetched from Supabase) -->
        <div class="space-y-2">
          <div class="text-[10px] text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-2 font-pixel">
            currently
          </div>
          <ul id="currently-list" class="space-y-2 text-xs">
            {
              currentlyItems.map((item) => (
                <li class="leading-relaxed">
                  <span class="font-pixel text-neutral-800 dark:text-neutral-200 font-medium">
                    {item.action}
                  </span>
                  <span class="text-neutral-400 dark:text-neutral-600 mx-1">—</span>
                  <span class="font-sans text-neutral-600 dark:text-neutral-400">
                    {item.detail}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right Column (2/3 Width — Bio & Selected Works) -->
      <div class="md:col-span-8 space-y-8 pt-4">
        <!-- Bio Header -->
        <h2 class="text-base font-bold font-pixel text-[#1a1a1a] dark:text-white">
          Hi! 👋
        </h2>

        <!-- Bio Paragraphs (Supports HTML <strong> tags for bolding) -->
        <div id="profile-bio" class="space-y-4 text-sm sm:text-base leading-relaxed text-[#1a1a1a] dark:text-neutral-200 font-sans">
          {
            Array.isArray(profile.bio) ? (
              profile.bio.map((paragraph: string) => <p set:html={paragraph} />)
            ) : (
              <p set:html={profile.bio} />
            )
          }
        </div>

        <!-- Hairline Divider -->
        <div class="border-t border-[#d0d0d0] dark:border-[#404040] pt-8 mt-8">
          <!-- Recent Projects Section (Dynamically Fetched & Perfectly Aligned Grid) -->
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <!-- Recent Projects (Capitalized) -->
              <h3 class="text-xs font-pixel text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
                Recent Projects
              </h3>
              <a href="/projects" class="font-sans text-xs link-slate">
                view all →
              </a>
            </div>

            <!-- Quiet Project List (Perfect 12-column grid alignment) -->
            <div id="recent-projects-list" class="space-y-4">
              {
                recentProjects.map((project) => {
                  const tagStr = project.tags.join(' · ');
                  return (
                    <div class="grid grid-cols-1 sm:grid-cols-12 items-baseline gap-2 py-2 text-sm border-b border-neutral-300/30 dark:border-neutral-800/60 pb-3 last:border-0">
                      <div class="sm:col-span-5">
                        <a
                          href={`/projects/${project.slug}`}
                          class="font-pixel font-bold link-slate block"
                        >
                          {project.title}
                        </a>
                      </div>

                      <div class="sm:col-span-7 sm:text-right font-pixel text-xs text-neutral-500 dark:text-neutral-400">
                        {tagStr}
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side hydration script for instant live Supabase data updates -->
  <script>
    import { getCurrentlyItems, getProfile, getProjects, type ConnectLink } from '../lib/supabase';

    async function refreshLiveData() {
      try {
        const [profile, items, projects] = await Promise.all([
          getProfile(),
          getCurrentlyItems(),
          getProjects(),
        ]);

        if (profile) {
          const nameEl = document.getElementById('profile-name');
          if (nameEl && profile.name) nameEl.textContent = profile.name;

          const rolesEl = document.getElementById('profile-roles');
          if (rolesEl && profile.roles) {
            rolesEl.innerHTML = profile.roles
              .map((r: string) => `<div class="leading-snug">${r}</div>`)
              .join('');
          }

          const connectEl = document.getElementById('connect-links');
          if (connectEl && profile.connect_links && profile.connect_links.length > 0) {
            connectEl.innerHTML = profile.connect_links
              .map((link: ConnectLink, idx: number) => {
                const isMail = link.url.startsWith('mailto:');
                const isLast = idx === profile.connect_links.length - 1;
                const linkHtml = `<a href="${link.url}" ${isMail ? '' : 'target="_blank" rel="noopener noreferrer"'} class="link-slate">${link.label} ↗</a>`;
                return isLast ? linkHtml : `${linkHtml}<span class="text-neutral-400 dark:text-neutral-600">/</span>`;
              })
              .join('');
          }

          const bioEl = document.getElementById('profile-bio');
          if (bioEl && profile.bio) {
            if (Array.isArray(profile.bio)) {
              bioEl.innerHTML = profile.bio
                .map((p: string) => `<p>${p}</p>`)
                .join('');
            } else {
              bioEl.innerHTML = `<p>${profile.bio}</p>`;
            }
          }
        }

        const container = document.getElementById('currently-list');
        if (container && items && items.length > 0) {
          container.innerHTML = items
            .map(
              (item) => `
            <li class="leading-relaxed">
              <span class="font-pixel text-neutral-800 dark:text-neutral-200 font-medium">${item.action}</span>
              <span class="text-neutral-400 dark:text-neutral-600 mx-1">—</span>
              <span class="font-sans text-neutral-600 dark:text-neutral-400">${item.detail}</span>
            </li>`
            )
            .join('');
        }

        const recentProjectsEl = document.getElementById('recent-projects-list');
        if (recentProjectsEl && projects && projects.length > 0) {
          const recentList = projects.slice(0, 3);
          recentProjectsEl.innerHTML = recentList
            .map((project) => {
              const tagStr = project.tags ? project.tags.join(' · ') : '';
              return `
              <div class="grid grid-cols-1 sm:grid-cols-12 items-baseline gap-2 py-2 text-sm border-b border-neutral-300/30 dark:border-neutral-800/60 pb-3 last:border-0">
                <div class="sm:col-span-5">
                  <a href="/projects/${project.slug}" class="font-pixel font-bold link-slate block">
                    ${project.title}
                  </a>
                </div>
                <div class="sm:col-span-7 sm:text-right font-pixel text-xs text-neutral-500 dark:text-neutral-400">
                  ${tagStr}
                </div>
              </div>`;
            })
            .join('');
        }
      } catch {
        // Keep pre-rendered fallback HTML
      }
    }

    refreshLiveData();
    document.addEventListener('astro:after-swap', refreshLiveData);
  </script>

  <style>
    .cat-scribble-anim {
      filter: url(#cat-scribble-filter);
      animation: cat-scribble-wiggle 0.35s steps(2, end) infinite;
      will-change: transform, filter;
    }

    @keyframes cat-scribble-wiggle {
      0% {
        transform: scale(1) rotate(0deg) translate(0px, 0px);
      }
      25% {
        transform: scale(1.015) rotate(-0.75deg) translate(-0.5px, 0.5px);
      }
      50% {
        transform: scale(0.99) rotate(0.75deg) translate(0.5px, -0.5px);
      }
      75% {
        transform: scale(1.01) rotate(-0.5deg) translate(0.5px, 0.5px);
      }
      100% {
        transform: scale(1) rotate(0deg) translate(0px, 0px);
      }
    }
  </style>
</BaseLayout>
