---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperiences, getAchievements, getCertificates, formatRichText } from '../lib/supabase';

const sortedExperience = await getExperiences();
const achievements = await getAchievements();
const certificates = await getCertificates();
---

<BaseLayout
  title="Experience — Alex Chen"
  description="Work history, technical leadership, and engineering achievements."
>
  <div class="space-y-16 max-w-3xl mx-auto">
    <!-- Header Section -->
    <div class="space-y-2 border-b border-[#d0d0d0] dark:border-[#404040] pb-6">
      <!-- Page Title: Experience (Capitalized) -->
      <h1 class="text-xl font-bold tracking-tight text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
        Experience
      </h1>
      <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Work history, technical leadership, and engineering achievements.
      </p>
    </div>

    <!-- Sub-Navigation / Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 pt-2 pb-4 border-b border-neutral-300 dark:border-neutral-800 font-pixel text-xs">
      <button
        data-filter="all"
        class="exp-tab-btn px-3 py-1.5 rounded-md border font-bold transition-all duration-150 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 border-neutral-900 dark:border-white shadow-sm cursor-pointer"
      >
        All
      </button>
      <button
        data-filter="work"
        class="exp-tab-btn px-3 py-1.5 rounded-md border font-normal transition-all duration-150 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 border-neutral-300 dark:border-neutral-800 bg-transparent cursor-pointer"
      >
        Work Experience
      </button>
      <button
        data-filter="achievements"
        class="exp-tab-btn px-3 py-1.5 rounded-md border font-normal transition-all duration-150 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 border-neutral-300 dark:border-neutral-800 bg-transparent cursor-pointer"
      >
        Achievements & Honors
      </button>
      <button
        data-filter="certificates"
        class="exp-tab-btn px-3 py-1.5 rounded-md border font-normal transition-all duration-150 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 border-neutral-300 dark:border-neutral-800 bg-transparent cursor-pointer"
      >
        Certifications & Learning
      </button>
    </div>

    <!-- Section 1: Work Experience (Dynamically Fetched from Supabase) -->
    <section id="work-experience-section" class="space-y-8 mt-6">
      <div class="space-y-1.5 border-b border-neutral-300 dark:border-neutral-800 pb-4">
        <h2 class="text-xs font-pixel font-bold tracking-wider text-neutral-500 dark:text-neutral-400 uppercase">
          Work Experience
        </h2>
        <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Roles, engineering leadership, and product architecture impact.
        </p>
      </div>

      <div id="experiences-list" class="space-y-10 mt-6 sm:mt-8">
        {
          sortedExperience.map((exp) => (
            <article class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-8 pb-10 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 last:pb-0">
              <!-- Left Column: Date Range (4 cols) in Departure Mono -->
              <div class="sm:col-span-4 font-pixel text-xs text-neutral-500">
                {exp.start_date} — {exp.end_date}
              </div>

              <!-- Right Column: Role Title & Impact Bullet Points -->
              <div class="sm:col-span-8 space-y-3">
                <div>
                  <h3 class="text-base font-bold text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
                    {exp.role}
                  </h3>
                  <p class="text-xs font-sans text-neutral-500 mt-0.5">
                    {exp.company} · {exp.location}
                  </p>
                </div>

                <!-- 2–3 Concise Impact Bullet Points using Standard Dashes (—) -->
                {exp.highlights && exp.highlights.length > 0 && (
                  <ul class="space-y-2 text-sm font-sans text-neutral-700 dark:text-neutral-300">
                    {exp.highlights.map((item) => (
                      <li class="flex items-start space-x-2 leading-relaxed">
                        <span class="text-neutral-400 font-pixel text-xs shrink-0 mt-0.5">—</span>
                        <span set:html={formatRichText(item)} />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Section 2: Achievements & Honors (Dynamically Fetched from Supabase) -->
    <section id="achievements-section" class="space-y-8 transition-all duration-200 border-t border-neutral-200 dark:border-neutral-800 pt-12 sm:pt-16 mt-12 sm:mt-16">
      <div class="space-y-1.5 border-b border-neutral-300 dark:border-neutral-800 pb-4">
        <h2 class="text-xs font-pixel font-bold tracking-wider text-neutral-500 dark:text-neutral-400 uppercase">
          Achievements & Honors
        </h2>
        <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Key recognition, hackathon awards, and technical speaking keynotes.
        </p>
      </div>

      <div id="achievements-list" class="space-y-8 mt-6 sm:mt-8">
        {
          achievements.map((item) => (
            <article class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-8 pb-8 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 last:pb-0">
              <!-- Left Column: Date (4 cols) in Departure Mono -->
              <div class="sm:col-span-4 font-pixel text-xs text-neutral-500">
                {item.date}
              </div>

              <!-- Right Column: Title, Entity & 1-Line Detail -->
              <div class="sm:col-span-8 space-y-1">
                <h3 class="font-bold text-xs text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
                  {item.title}
                </h3>
                <p class="text-xs font-sans text-neutral-500">
                  {item.entity}
                </p>
                <p set:html={formatRichText(item.impact)} class="text-sm font-sans text-neutral-700 dark:text-neutral-300 leading-relaxed pt-0.5 font-normal" />
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Section 3: Certificates (Dynamically Fetched from Supabase) -->
    <section id="certificates-section" class="space-y-8 transition-all duration-200 border-t border-neutral-200 dark:border-neutral-800 pt-12 sm:pt-16 mt-12 sm:mt-16">
      <div class="space-y-1.5 border-b border-neutral-300 dark:border-neutral-800 pb-4">
        <h2 class="text-xs font-pixel font-bold tracking-wider text-neutral-500 dark:text-neutral-400 uppercase">
          Certifications & Learning
        </h2>
        <p class="text-sm font-sans text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Verified professional credentials, architecture certifications, and coursework.
        </p>
      </div>

      <div id="certificates-list" class="space-y-8 mt-6 sm:mt-8">
        {
          certificates.map((cert) => (
            <article class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-8 pb-8 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 last:pb-0">
              <!-- Left Column: Issue Date (4 cols) in Departure Mono -->
              <div class="sm:col-span-4 font-pixel text-xs text-neutral-500">
                {cert.issue_date}
              </div>

              <!-- Right Column: Title, Issuer, Credential Link & Description -->
              <div class="sm:col-span-8 space-y-1.5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-bold text-xs text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
                    {cert.title}
                  </h3>
                  {cert.credential_url && (
                    <a
                      href={cert.credential_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-pixel text-[10px] link-slate text-neutral-500 dark:text-neutral-400"
                    >
                      See Certificate ↗
                    </a>
                  )}
                </div>
                <p class="text-xs font-sans text-neutral-500">
                  {cert.issuer} {cert.credential_id ? `· ID: ${cert.credential_id}` : ''}
                </p>
                {cert.description && (
                  <p set:html={formatRichText(cert.description)} class="text-sm font-sans text-neutral-700 dark:text-neutral-300 leading-relaxed pt-0.5 font-normal" />
                )}
                {cert.skills && cert.skills.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {cert.skills.map((skill) => (
                      <span class="font-pixel text-[10px] text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800/80 px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-700">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Client-side hydration script for instant live Supabase data updates & category filtering -->
  <script>
    import { getExperiences, getAchievements, getCertificates, formatRichText } from '../lib/supabase';

    function initExperienceTabs() {
      const tabBtns = document.querySelectorAll('.exp-tab-btn');
      const workSec = document.getElementById('work-experience-section');
      const achSec = document.getElementById('achievements-section');
      const certSec = document.getElementById('certificates-section');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Reset styling
          tabBtns.forEach((b) => {
            b.classList.remove(
              'bg-neutral-900', 'dark:bg-white', 'text-white', 'dark:text-neutral-900',
              'border-neutral-900', 'dark:border-white', 'font-bold', 'shadow-sm'
            );
            b.classList.add(
              'text-neutral-500', 'hover:text-neutral-900', 'dark:hover:text-neutral-200',
              'border-neutral-300', 'dark:border-neutral-800', 'bg-transparent', 'font-normal'
            );
          });

          // Active styling
          btn.classList.remove(
            'text-neutral-500', 'hover:text-neutral-900', 'dark:hover:text-neutral-200',
            'border-neutral-300', 'dark:border-neutral-800', 'bg-transparent', 'font-normal'
          );
          btn.classList.add(
            'bg-neutral-900', 'dark:bg-white', 'text-white', 'dark:text-neutral-900',
            'border-neutral-900', 'dark:border-white', 'font-bold', 'shadow-sm'
          );

          if (filter === 'all') {
            if (workSec) { workSec.style.display = 'block'; workSec.className = "space-y-8 mt-6"; }
            if (achSec) { achSec.style.display = 'block'; achSec.className = "space-y-8 transition-all duration-200 border-t border-neutral-200 dark:border-neutral-800 pt-12 sm:pt-16 mt-12 sm:mt-16"; }
            if (certSec) { certSec.style.display = 'block'; certSec.className = "space-y-8 transition-all duration-200 border-t border-neutral-200 dark:border-neutral-800 pt-12 sm:pt-16 mt-12 sm:mt-16"; }
          } else if (filter === 'work') {
            if (workSec) { workSec.style.display = 'block'; workSec.className = "space-y-8 mt-6"; }
            if (achSec) { achSec.style.display = 'none'; }
            if (certSec) { certSec.style.display = 'none'; }
          } else if (filter === 'achievements') {
            if (workSec) { workSec.style.display = 'none'; }
            if (achSec) { achSec.style.display = 'block'; achSec.className = "space-y-8 transition-all duration-200 mt-6 pt-0 border-t-0"; }
            if (certSec) { certSec.style.display = 'none'; }
          } else if (filter === 'certificates') {
            if (workSec) { workSec.style.display = 'none'; }
            if (achSec) { achSec.style.display = 'none'; }
            if (certSec) { certSec.style.display = 'block'; certSec.className = "space-y-8 transition-all duration-200 mt-6 pt-0 border-t-0"; }
          }
        });
      });
    }

    async function refreshExperiencePage() {
      try {
        const [exps, achs, certs] = await Promise.all([
          getExperiences(),
          getAchievements(),
          getCertificates(),
        ]);

        const expContainer = document.getElementById('experiences-list');
        if (expContainer && exps && exps.length > 0) {
          expContainer.innerHTML = exps
            .map(
              (exp) => `
            <article class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-8 pb-10 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 last:pb-0">
              <div class="sm:col-span-4 font-pixel text-xs text-neutral-500">
                ${exp.start_date} — ${exp.end_date}
              </div>
              <div class="sm:col-span-8 space-y-3">
                <div>
                  <h3 class="text-base font-bold text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
                    ${exp.role}
                  </h3>
                  <p class="text-xs font-sans text-neutral-500 mt-0.5">
                    ${exp.company} · ${exp.location}
                  </p>
                </div>
                ${
                  exp.highlights && exp.highlights.length > 0
                    ? `<ul class="space-y-2 text-sm font-sans text-neutral-700 dark:text-neutral-300">
                        ${exp.highlights
                          .map(
                            (item) => `
                          <li class="flex items-start space-x-2 leading-relaxed">
                            <span class="text-neutral-400 font-pixel text-xs shrink-0 mt-0.5">—</span>
                            <span>${formatRichText(item)}</span>
                          </li>`
                          )
                          .join('')}
                      </ul>`
                    : ''
                }
              </div>
            </article>`
            )
            .join('');
        }

        const achContainer = document.getElementById('achievements-list');
        if (achContainer && achs && achs.length > 0) {
          achContainer.innerHTML = achs
            .map(
              (item) => `
            <article class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-8 pb-8 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 last:pb-0">
              <div class="sm:col-span-4 font-pixel text-xs text-neutral-500">
                ${item.date}
              </div>
              <div class="sm:col-span-8 space-y-1">
                <h3 class="font-bold text-xs text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
                  ${item.title}
                </h3>
                <p class="text-xs font-sans text-neutral-500">
                  ${item.entity}
                </p>
                <p class="text-sm font-sans text-neutral-700 dark:text-neutral-300 leading-relaxed pt-0.5 font-normal">
                  ${formatRichText(item.impact)}
                </p>
              </div>
            </article>`
            )
            .join('');
        }

        const certContainer = document.getElementById('certificates-list');
        if (certContainer && certs && certs.length > 0) {
          certContainer.innerHTML = certs
            .map(
              (cert) => `
            <article class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-8 pb-8 border-b border-neutral-300/30 dark:border-neutral-800/60 last:border-0 last:pb-0">
              <div class="sm:col-span-4 font-pixel text-xs text-neutral-500">
                ${cert.issue_date}
              </div>
              <div class="sm:col-span-8 space-y-1.5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-bold text-xs text-[#1a1a1a] dark:text-[#e8e8e8] font-pixel">
                    ${cert.title}
                  </h3>
                  ${cert.credential_url ? `<a href="${cert.credential_url}" target="_blank" rel="noopener noreferrer" class="font-pixel text-[10px] link-slate text-neutral-500 dark:text-neutral-400">See Certificate ↗</a>` : ''}
                </div>
                <p class="text-xs font-sans text-neutral-500">
                  ${cert.issuer} ${cert.credential_id ? `· ID: ${cert.credential_id}` : ''}
                </p>
                ${cert.description ? `<p class="text-sm font-sans text-neutral-700 dark:text-neutral-300 leading-relaxed pt-0.5 font-normal">${formatRichText(cert.description)}</p>` : ''}
                ${cert.skills && cert.skills.length > 0 ? `<div class="flex flex-wrap gap-1.5 pt-1">${cert.skills.map((s) => `<span class="font-pixel text-[10px] text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800/80 px-2 py-0.5 rounded border border-neutral-200 dark:border-neutral-700">${s}</span>`).join('')}</div>` : ''}
              </div>
            </article>`
            )
            .join('');
        }
      } catch {
        // Keep pre-rendered HTML
      }
    }

    const runInit = () => {
      initExperienceTabs();
      refreshExperiencePage();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runInit);
    } else {
      runInit();
    }

    document.addEventListener('astro:after-swap', runInit);
  </script>
</BaseLayout>
